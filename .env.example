# Copy to .env and replace only the placeholders needed by enabled integrations.
# Never commit real credentials.

# Server
SABOR_HOST=0.0.0.0
SABOR_PORT=8080
# Host port published by docker-compose.yml (bound to 127.0.0.1).
SABOR_HOST_PORT=9170

# Toolsets (comma-separated). Unset = core,import,shopping_sync; empty = discovery only.
# To keep the full 0.1.x surface add the legacy sets:
# SABOR_TOOLSETS=core,import,shopping_sync,pricing,legacy_spoonacular,legacy_pricing,legacy_memory,legacy_nutrition,legacy_catalog
# `pricing` (search_pricing_products, get_product_price, estimate_cost) needs a
# pricing provider such as SABOR_MERCADONA_ENABLED=true.
SABOR_TOOLSETS=core,import,shopping_sync

# Mercadona pricing provider (for the `pricing` toolset; legacy_pricing keeps
# price drops and new arrivals). Opt-in.
SABOR_MERCADONA_ENABLED=false

# Mealie (required). From Docker, a Mealie on the host is reachable at
# http://host.docker.internal:9925; on a shared Compose network use the
# service name, for example http://mealie:9000. Without Docker use
# http://localhost:9925.
MEALIE_BASE_URL=http://host.docker.internal:9925
MEALIE_API_TOKEN=

# Optional providers and integrations
SPOONACULAR_API_KEY=
VIDEO_RECIPE_WORKDIR=/tmp/video-recipe-mcp
# Local video files (stdio only): comma-separated absolute directories; empty = home.
SABOR_MEDIA_ROOTS=
# Optional local transcriber (pip install 'sabor-mcp[transcribe]'): tiny | base | small.
SABOR_TRANSCRIBE_MODEL=base
BRING_EMAIL=
BRING_PASSWORD=
BRING_CATALOG_DIR=
MERCADONA_WAREHOUSE=mad1

# Local persistent data
MEMORY_FILE=/data/MEMORY.md

# Import normalization. The parser name is sent to Mealie: nlp (local, default), brute,
# or openai (Mealie then uses the AI provider configured in Mealie).
SABOR_NORMALIZE_IMPORTS=true
SABOR_INGREDIENT_PARSER=nlp
SABOR_NORMALIZE_CONFIDENCE=0.75

# Nutrition remains disabled until a reviewed staged rollout.
SABOR_NUTRITION_ENABLED=false
SABOR_NUTRITION_DB=/data/nutrition.db
SABOR_NUTRITION_PROVIDER=spoonacular
SABOR_NUTRITION_MIN_PROFILE_CONFIDENCE=0.80
SABOR_NUTRITION_MIN_PUBLISH_COVERAGE=0.90
SABOR_NUTRITION_MIN_PUBLISH_CONFIDENCE=0.80
SABOR_NUTRITION_PUBLISH_ESTIMATES=false
SABOR_NUTRITION_PROFILE_TTL_DAYS=180
SABOR_NUTRITION_NOT_FOUND_TTL_DAYS=30
SABOR_NUTRITION_SOURCE_LANGUAGE=es
SABOR_NUTRITION_DEFAULT_CUP_ML=240
SABOR_NUTRITION_AUTO_ON_IMPORT=false
SABOR_NUTRITION_AUTO_PUBLISH=false
